#include <stdio.h>
int main() {
 int numbers[5] = {40, 10, 50, 20, 30};
 int temp;
 for (int i = 0; i < 5 - 1; i++) {
for (int j = 0; j < 5 - i - 1; j++) {
 if (numbers[j] > numbers[j + 1]) {
  temp = numbers[j];
 numbers[j] = numbers[j + 1];
 numbers[j + 1] = temp;
}
  }
 }
 printf("Sorted values:\n");
 for (int i = 0; i < 5; i++) {
  }
printf("%d\n", numbers[i]);
 return 0;
}
